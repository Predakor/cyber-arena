.container {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    width: 100%;
    height: 100%;
}

.open {
    opacity: 1;
}

.modules-contanier {
    height: 30%;
    width: 70%;
    position: absolute;
    display:flex;
    flex-direction: row;
    bottom: 0;
    padding: 32px;
    background-color: rgba(255, 255, 255, 0.12);
}
