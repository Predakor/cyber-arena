    <ui:VisualElement name="Container" class="container open" style="height: 1714px; justify-content: center; align-self: center; align-items: center; background-color: rgba(0, 0, 0, 0.49);">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(0, 0, 0); max-width: 1920px; max-height: 1080px; align-self: auto; width: 100%; height: 100%; opacity: 1; justify-content: flex-start;">
            <ui:GroupBox name="StatsEffects-Panel" style="width: 30%; height: 100%; align-self: flex-end; justify-content: flex-start; align-items: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:GroupBox name="stats-container" style="height: 70%; background-color: rgb(255, 255, 255); align-items: auto; align-self: auto; flex-direction: column; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
